    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "5.9",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
